CompileFlags:
  Add:
    - "-Wall"
    - "-Wpedantic"
    - "-Wextra"
    - "-xc"
    - "-Wdocumentation"
    - "-Wconversion"
    - "-Wsign-conversion"
    - "-Wshadow"
    - "-Wformat=2"
    - "-Wundef"
    - "-Wcast-align"
    - "-Wcast-qual"
    - "-Wstrict-prototypes"
    - "-Wmissing-prototypes"
    - "-Wmissing-declarations"
    - "-Wold-style-definition"
    - "-Wredundant-decls"
    - "-Wnested-externs"
    - "-Wwrite-strings"
    - "-Wswitch-enum"
    - "-Wswitch-default"
    - "-Wfloat-equal"
    - "-Wpointer-arith"
    - "-Wbad-function-cast"
    - "-Wstrict-overflow=5"
    - "-Walloca"
    - "-Wvla"
    - "-Wstack-protector"
    - "-Wformat-overflow=2"
    - "-Wformat-truncation=2"
    - "-Wstringop-overflow=4"
    - "-Warray-bounds=2"
    - "-Wshift-overflow=2"
    - "-Wnull-dereference"
    - "-Wduplicated-cond"
    - "-Wduplicated-branches"
    - "-Wlogical-op"
    - "-Wjump-misses-init"
    - "-Wtrampolines"
    - "-Wuse-after-free=3"
    - "-Wreserved-macro-identifier"
    - "-Wpacked"
    - "-Wdocumentation-unknown-command"
    - "-Wcast-function-type-strict"
    - "-std=c11"
    - "-fPIC"

Documentation:
  CommentFormat: Doxygen
